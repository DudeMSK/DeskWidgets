{
  "name": "deskwidgets",
  "version": "0.1.0",
  "private": true,
  "description": "Виджеты рабочего стола Windows 11 (фоновое приложение с иконкой в трее)",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "icons": "node scripts/make-icon.js",
    "probe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/winprobe.ps1"
  },
  "devDependencies": {
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "koffi": "^3.3.3"
  },
  "build": {
    "appId": "local.deskwidgets",
    "productName": "DeskWidgets",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "widgets/**/*", "assets/**/*", "native/**/*", "package.json"],
    "asarUnpack": ["native/**/*"],
    "win": {
      "icon": "assets/icon.png",
      "target": [{ "target": "nsis", "arch": ["x64"] }]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
